<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="pe.edu.upeu.piscicontrolf.controller.UsuariosController"
        prefWidth="1350"
        prefHeight="820"
        stylesheets="@piscicontrol.css"
        styleClass="pantalla">

    <!-- MENU LATERAL -->
    <left>
        <VBox prefWidth="240"
              spacing="10"
              styleClass="menu-lateral">

            <Label text="PisciControlF"
                   styleClass="logo"/>

            <Label text="Gestión inteligente de piscigranjas"
                   wrapText="true"
                   styleClass="logo-subtitulo"/>

            <Separator/>

            <Label text="ADMINISTRACIÓN"
                   styleClass="menu-pie"/>

            <Button text="Panel principal"
                    onAction="#volverAlPanel"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Gestión de estanques"
                    onAction="#abrirEstanques"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Lotes de truchas"
                    onAction="#abrirLotes"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Alimentación"
                    onAction="#abrirAlimentacion"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Crecimiento"
                    onAction="#abrirCrecimiento"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Calidad del agua"
                    onAction="#abrirCalidadAgua"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Mortalidad y Sanidad"
                    onAction="#abrirMortalidad"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Producción"
                    onAction="#abrirProduccion"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Ventas"
                    onAction="#abrirVentas"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Reportes"
                    onAction="#abrirReportes"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Gestión de Usuarios"
                    maxWidth="Infinity"
                    styleClass="menu-activo"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="PisciControlF | Versión 1.0"
                   styleClass="menu-pie"/>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F3F7FC;">

            <VBox spacing="20"
                  styleClass="contenido">

                <!-- ENCABEZADO -->
                <HBox alignment="CENTER_LEFT"
                      spacing="12">

                    <VBox spacing="5">
                        <Label text="Gestión de Usuarios"
                               styleClass="titulo"/>

                        <Label
                                text="Administración de cuentas, roles y accesos al sistema"
                                styleClass="subtitulo"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="SOLO ADMINISTRADOR"
                           styleClass="etiqueta-superior"/>
                </HBox>

                <!-- INDICADORES -->
                <HBox spacing="15">

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS"
                          styleClass="tarjeta-indicador">

                        <Label text="TOTAL DE USUARIOS"
                               styleClass="indicador-titulo"/>

                        <Label fx:id="lblTotalUsuarios"
                               text="0"
                               styleClass="indicador-numero"/>
                    </VBox>

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS"
                          styleClass="tarjeta-indicador">

                        <Label text="USUARIOS ACTIVOS"
                               styleClass="indicador-titulo"/>

                        <Label fx:id="lblActivos"
                               text="0"
                               styleClass="indicador-numero"/>
                    </VBox>

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS"
                          styleClass="tarjeta-indicador">

                        <Label text="USUARIOS INACTIVOS"
                               styleClass="indicador-titulo"/>

                        <Label fx:id="lblInactivos"
                               text="0"
                               styleClass="indicador-numero"/>
                    </VBox>

                </HBox>

                <!-- FORMULARIO -->
                <VBox spacing="15"
                      styleClass="tarjeta">

                    <Label text="Registrar o modificar usuario"
                           styleClass="seccion-titulo"/>

                    <Label
                            text="Administra las cuentas que tienen acceso a PisciControlF."
                            styleClass="subtitulo"/>

                    <Separator/>

                    <GridPane hgap="18" vgap="12">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <!-- NOMBRE Y USUARIO -->
                        <Label text="Nombre completo"
                               styleClass="campo-titulo"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <Label text="Nombre de usuario"
                               styleClass="campo-titulo"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Nombre y apellidos"
                                   styleClass="campo"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                        <TextField fx:id="txtUsuario"
                                   promptText="Ej. operador01"
                                   styleClass="campo"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <!-- ROL -->
                        <Label text="Rol del usuario"
                               styleClass="campo-titulo"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"/>

                        <ComboBox fx:id="cmbRol"
                                  promptText="Seleccione un rol"
                                  maxWidth="Infinity"
                                  styleClass="campo"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="3"/>

                        <!-- CONTRASEÑAS -->
                        <Label text="Contraseña"
                               styleClass="campo-titulo"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="4"/>

                        <Label text="Confirmar contraseña"
                               styleClass="campo-titulo"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>

                        <PasswordField fx:id="txtPassword"
                                       promptText="Ingrese una contraseña"
                                       styleClass="campo"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="5"/>

                        <PasswordField fx:id="txtConfirmarPassword"
                                       promptText="Repita la contraseña"
                                       styleClass="campo"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="5"/>

                    </GridPane>

                    <Label
                            text="Las contraseñas se utilizarán solo al crear o restablecer una cuenta; nunca se mostrarán las contraseñas guardadas."
                            wrapText="true"
                            styleClass="subtitulo"/>

                    <Separator/>

                    <!-- BOTONES -->
                    <HBox spacing="10" alignment="CENTER_LEFT">

                        <Button fx:id="btnRegistrar"
                                text="Registrar usuario"
                                onAction="#registrarUsuario"
                                styleClass="boton-primario"/>

                        <Button fx:id="btnModificar"
                                text="Modificar usuario"
                                onAction="#modificarUsuario"
                                styleClass="boton-secundario"/>

                        <Button fx:id="btnCambiarEstado"
                                text="Activar / Desactivar"
                                onAction="#cambiarEstadoUsuario"
                                styleClass="boton-secundario"/>

                        <Button fx:id="btnRestablecerPassword"
                                text="Restablecer contraseña"
                                onAction="#restablecerPassword"
                                styleClass="boton-secundario"/>

                        <Button text="Limpiar"
                                onAction="#limpiarFormulario"
                                styleClass="boton-limpiar"/>

                    </HBox>

                </VBox>

                <!-- HISTORIAL -->
                <VBox spacing="15"
                      styleClass="tarjeta">

                    <Label text="Usuarios registrados"
                           styleClass="seccion-titulo"/>

                    <Label
                            text="Consulta las cuentas, sus roles y su estado actual."
                            styleClass="subtitulo"/>

                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por nombre, usuario, rol o estado..."
                               styleClass="campo"/>

                    <TableView fx:id="tablaUsuarios"
                               prefHeight="330">

                        <columnResizePolicy>
                            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                        <columns>

                            <TableColumn fx:id="colId"
                                         text="ID"
                                         prefWidth="70"/>

                            <TableColumn fx:id="colNombre"
                                         text="Nombre completo"
                                         prefWidth="260"/>

                            <TableColumn fx:id="colUsuario"
                                         text="Usuario"
                                         prefWidth="170"/>

                            <TableColumn fx:id="colRol"
                                         text="Rol"
                                         prefWidth="170"/>

                            <TableColumn fx:id="colEstado"
                                         text="Estado"
                                         prefWidth="140"/>

                        </columns>

                        <placeholder>
                            <Label text="No hay usuarios registrados"/>
                        </placeholder>

                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>


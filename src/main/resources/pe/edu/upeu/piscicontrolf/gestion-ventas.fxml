<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.piscicontrolf.controller.VentaController"
            id="pantallaVentas"
            prefWidth="1350"
            prefHeight="820"
            stylesheets="@piscicontrol.css"
            styleClass="pantalla">

    <!-- MENU LATERAL CORPORATIVO -->
    <left>
        <VBox prefWidth="240" spacing="9" styleClass="menu-lateral">
            <Label text="PisciControlF" styleClass="logo"/>
            <Label text="Gestión inteligente de piscigranjas"
                   wrapText="true" styleClass="logo-subtitulo"/>
            <Separator/>
            <Label text="OPERACIONES" styleClass="menu-pie"/>

            <Button text="Panel principal" onAction="#volverAlPanel"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Gestión de estanques" onAction="#abrirEstanques"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Lotes de truchas" onAction="#abrirLotes"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Alimentación" onAction="#abrirAlimentacion"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Crecimiento" onAction="#abrirCrecimiento"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Producción" onAction="#abrirProduccion"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Separator/>
            <Label text="GESTIÓN COMERCIAL" styleClass="menu-pie"/>
            <Button text="Ventas" maxWidth="Infinity" styleClass="menu-activo"/>
            <Button text="Reportes" disable="true"
                    maxWidth="Infinity" styleClass="menu-boton"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="PisciControlF | Versión 1.0" styleClass="menu-pie"/>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: #F3F7FC; -fx-border-color: transparent;">
            <VBox spacing="20" styleClass="contenido">

                <!-- ENCABEZADO -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="6">
                        <Label text="Gestión de Ventas" styleClass="titulo"/>
                        <Label text="Registro comercial de truchas, ingresos y stock disponible por producción"
                               wrapText="true" styleClass="subtitulo"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="CONTROL COMERCIAL" styleClass="etiqueta-superior"/>
                </HBox>

                <!-- INDICADORES -->
                <GridPane hgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.34"/>
                    </columnConstraints>

                    <VBox spacing="8" GridPane.columnIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E1E9F3; -fx-border-radius: 14; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);">
                        <Label text="VENTAS REGISTRADAS" styleClass="indicador-titulo"/>
                        <Label fx:id="lblTotalVentas" text="0"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #173657;"/>
                        <Label text="Ventas activas" styleClass="subtitulo"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="1"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E1E9F3; -fx-border-radius: 14; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);">
                        <Label text="KILOGRAMOS VENDIDOS" styleClass="indicador-titulo"/>
                        <Label fx:id="lblKgVendidos" text="0.000 kg"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                        <Label text="Ventas no anuladas" styleClass="subtitulo"/>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="2"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E1E9F3; -fx-border-radius: 14; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);">
                        <Label text="INGRESOS POR VENTAS" styleClass="indicador-titulo"/>
                        <Label fx:id="lblIngresosTotales" text="S/ 0.00"
                               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #079B83;"/>
                        <Label text="Importe de ventas activas" styleClass="subtitulo"/>
                    </VBox>
                </GridPane>

                <!-- FORMULARIO Y RESUMEN -->
                <HBox spacing="18" alignment="TOP_LEFT">
                    <VBox prefWidth="660" minWidth="450" spacing="14"
                          HBox.hgrow="ALWAYS" styleClass="tarjeta">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="5">
                                <Label text="Registrar venta" styleClass="seccion-titulo"/>
                                <Label text="Complete los datos de la operación comercial."
                                       styleClass="subtitulo"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="NUEVA VENTA"
                                   style="-fx-background-color: #EAF2FD; -fx-background-radius: 7; -fx-padding: 7 11; -fx-text-fill: #2466B2; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        </HBox>
                        <Separator/>

                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <Label text="Producción de truchas" styleClass="campo-titulo"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Fecha de venta" styleClass="campo-titulo"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="cmbProduccion" promptText="Seleccione una producción"
                                      maxWidth="Infinity" styleClass="campo"
                                      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <DatePicker fx:id="dpFecha" maxWidth="Infinity" styleClass="campo"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Cliente / comprador" styleClass="campo-titulo"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label text="Cantidad vendida (kg)" styleClass="campo-titulo"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <TextField fx:id="txtCliente" promptText="Ej. Restaurante El Lago"
                                       maxWidth="Infinity" styleClass="campo"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="txtCantidadKg" promptText="Ej. 25.000"
                                       maxWidth="Infinity" styleClass="campo"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Precio por kilogramo (S/)" styleClass="campo-titulo"
                                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label text="Total calculado (S/)" styleClass="campo-titulo"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <TextField fx:id="txtPrecioUnitarioKg" promptText="Ej. 15.00"
                                       maxWidth="Infinity" styleClass="campo"
                                       GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <Label fx:id="lblTotalCalculado" text="S/ 0.00"
                                   maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                   style="-fx-background-color: #EAF7EF; -fx-background-radius: 8; -fx-padding: 11 14; -fx-text-fill: #127447; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        </GridPane>

                        <Label text="Observaciones" styleClass="campo-titulo"/>
                        <TextArea fx:id="txtObservaciones" prefRowCount="3" wrapText="true"
                                  promptText="Detalles opcionales de la venta..."
                                  styleClass="campo"/>

                        <Separator/>
                        <Label text="ACCIONES DISPONIBLES" styleClass="indicador-titulo"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <Button fx:id="btnRegistrar" text="Registrar venta"
                                    onAction="#registrarVenta" maxWidth="Infinity"
                                    styleClass="boton-primario"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Button fx:id="btnModificar" text="Modificar venta"
                                    onAction="#modificarVenta" maxWidth="Infinity"
                                    styleClass="boton-secundario"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Button fx:id="btnAnular" text="Anular venta"
                                    onAction="#anularVenta" maxWidth="Infinity"
                                    GridPane.columnIndex="0" GridPane.rowIndex="1"
                                    style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-min-height: 44; -fx-cursor: hand;"/>
                            <Button fx:id="btnLimpiar" text="Limpiar formulario"
                                    onAction="#limpiarFormulario" maxWidth="Infinity"
                                    styleClass="boton-limpiar"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- DISPONIBILIDAD -->
                    <VBox prefWidth="295" minWidth="225" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E1E9F3; -fx-border-radius: 14; -fx-padding: 22;">
                        <Label text="Stock de la producción"
                               wrapText="true" styleClass="seccion-titulo"/>
                        <Label text="Kilogramos disponibles después de las ventas registradas."
                               wrapText="true" styleClass="subtitulo"/>
                        <Separator/>
                        <VBox spacing="10"
                              style="-fx-background-color: #EAF5FF; -fx-background-radius: 11; -fx-padding: 18;">
                            <Label text="KG DISPONIBLES" styleClass="indicador-titulo"/>
                            <Label fx:id="lblKgDisponibles" text="Seleccione una producción"
                                   wrapText="true"
                                   style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #087CC1;"/>
                            <Label text="Stock para nuevas ventas" wrapText="true"
                                   styleClass="subtitulo"/>
                        </VBox>
                        <Separator/>
                        <Label text="Indicaciones" styleClass="seccion-titulo"/>
                        <Label text="Seleccione una producción registrada y verifique sus kilogramos disponibles."
                               wrapText="true" styleClass="subtitulo"/>
                        <Label text="Ingrese la cantidad en kg y el precio unitario para calcular el total."
                               wrapText="true" styleClass="subtitulo"/>
                        <Label text="Las ventas anuladas se conservan en el historial, pero no descuentan stock."
                               wrapText="true" styleClass="subtitulo"/>
                    </VBox>
                </HBox>

                <!-- HISTORIAL -->
                <VBox spacing="15" styleClass="tarjeta">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="5">
                            <Label text="Historial de ventas" styleClass="seccion-titulo"/>
                            <Label text="Consulta las operaciones comerciales almacenadas en H2."
                                   styleClass="subtitulo"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="HISTORIAL" styleClass="etiqueta-superior"/>
                    </HBox>
                    <TextField fx:id="txtBuscar" promptText="Buscar por cliente, producción, fecha o estado..."
                               styleClass="campo"/>
                    <TableView fx:id="tablaVentas" prefHeight="350" minHeight="280">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="55" minWidth="35"/>
                            <TableColumn fx:id="colProduccion" text="Producción" prefWidth="105" minWidth="75"/>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="105" minWidth="85"/>
                            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="155" minWidth="110"/>
                            <TableColumn fx:id="colCantidad" text="Kg vendidos" prefWidth="125" minWidth="85"/>
                            <TableColumn fx:id="colPrecio" text="S/ por kg" prefWidth="115" minWidth="80"/>
                            <TableColumn fx:id="colTotal" text="Total (S/)" prefWidth="125" minWidth="85"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="115" minWidth="80"/>
                            <TableColumn fx:id="colObservaciones" text="Observaciones" prefWidth="190" minWidth="110"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay ventas registradas"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

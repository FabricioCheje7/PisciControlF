<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.piscicontrolf.controller.ProduccionController"
            id="pantallaProduccion"
            prefWidth="1350"
            prefHeight="820"
            stylesheets="@piscicontrol.css"
            styleClass="pantalla">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefWidth="240" spacing="9" styleClass="menu-lateral">
            <Label text="PisciControlF" styleClass="logo"/>
            <Label text="Gestión inteligente de piscigranjas"
                   wrapText="true" styleClass="logo-subtitulo"/>
            <Separator/>
            <Label text="MENÚ PRINCIPAL" styleClass="menu-pie"/>

            <Button text="Panel principal" onAction="#volverAlPanel"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Gestión de estanques" onAction="#abrirEstanques"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Lotes de truchas" onAction="#abrirLotes"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Alimentación" onAction="#abrirAlimentacion"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Crecimiento" onAction="#abrirCrecimiento"
                    maxWidth="Infinity" styleClass="menu-boton"/>
            <Button text="Producción" maxWidth="Infinity" styleClass="menu-activo"/>

            <Separator/>
            <Label text="GESTIÓN COMERCIAL" styleClass="menu-pie"/>
            <Button text="Ventas"
                    onAction="#abrirVentas"
                    maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Button text="Reportes" disable="true" maxWidth="Infinity"
                    styleClass="menu-boton"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="PisciControlF | Versión 1.0" styleClass="menu-pie"/>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-produccion">
            <VBox spacing="20" styleClass="contenido">

                <!-- ENCABEZADO -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="6">
                        <Label text="Gestión de Producción" styleClass="titulo"/>
                        <Label text="Control y seguimiento de las cosechas de truchas de tu piscigranja"
                               wrapText="true" styleClass="subtitulo"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="CONTROL DE COSECHAS" styleClass="etiqueta-superior"/>
                </HBox>

                <!-- TARJETAS DE INDICADORES -->
                <GridPane hgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.34"/>
                    </columnConstraints>

                    <VBox spacing="8" maxWidth="Infinity"
                          styleClass="produccion-indicador"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E1E9F3;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);"
                          GridPane.columnIndex="0">
                        <Label text="PRODUCCIONES REGISTRADAS"
                               styleClass="indicador-titulo"/>
                        <Label fx:id="lblTotalProducciones" text="0"
                               styleClass="produccion-numero"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #173657;"/>
                        <Label text="Registros de cosechas" styleClass="subtitulo"/>
                    </VBox>

                    <VBox spacing="8" maxWidth="Infinity"
                          styleClass="produccion-indicador"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E1E9F3;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);"
                          GridPane.columnIndex="1">
                        <Label text="TRUCHAS COSECHADAS" styleClass="indicador-titulo"/>
                        <Label fx:id="lblTotalTruchasCosechadas" text="0"
                               styleClass="produccion-numero-verde"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #079B83;"/>
                        <Label text="Cantidad acumulada" styleClass="subtitulo"/>
                    </VBox>

                    <VBox spacing="8" maxWidth="Infinity"
                          styleClass="produccion-indicador"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E1E9F3;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);"
                          GridPane.columnIndex="2">
                        <Label text="PRODUCCIÓN TOTAL" styleClass="indicador-titulo"/>
                        <Label fx:id="lblPesoTotalProducido" text="0.000 kg"
                               styleClass="produccion-numero-azul"
                               style="-fx-font-size: 30px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1976D2;"/>
                        <Label text="Peso total registrado" styleClass="subtitulo"/>
                    </VBox>
                </GridPane>

                <!-- FORMULARIO Y DISPONIBILIDAD -->
                <HBox spacing="18" alignment="TOP_LEFT">
                    <VBox spacing="15" prefWidth="660" minWidth="450"
                          HBox.hgrow="ALWAYS" styleClass="tarjeta">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="5">
                                <Label text="Registrar cosecha" styleClass="seccion-titulo"/>
                                <Label text="Complete los datos de la producción obtenida."
                                       styleClass="subtitulo"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="NUEVO REGISTRO" styleClass="produccion-etiqueta"/>
                        </HBox>
                        <Separator/>

                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <Label text="Lote de truchas" styleClass="campo-titulo"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Fecha de cosecha" styleClass="campo-titulo"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="cmbLote" promptText="Seleccione un lote"
                                      maxWidth="Infinity" styleClass="campo"
                                      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <DatePicker fx:id="dpFecha" maxWidth="Infinity"
                                        styleClass="campo"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Truchas cosechadas" styleClass="campo-titulo"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label text="Peso total (kg)" styleClass="campo-titulo"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <TextField fx:id="txtCantidad" promptText="Ej. 200"
                                       maxWidth="Infinity" styleClass="campo"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="txtPesoTotal" promptText="Ej. 75.500"
                                       maxWidth="Infinity" styleClass="campo"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>

                        <Label text="Observaciones de la cosecha"
                               styleClass="campo-titulo"/>
                        <TextArea fx:id="txtObservaciones"
                                  promptText="Registre los detalles u observaciones de la cosecha..."
                                  prefRowCount="3" wrapText="true" styleClass="campo"/>
                        <Separator/>
                        <Label text="ACCIONES DISPONIBLES"
                               styleClass="indicador-titulo"/>

                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <Button fx:id="btnRegistrar" text="Registrar producción"
                                    onAction="#registrarProduccion" maxWidth="Infinity"
                                    styleClass="boton-primario"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Button fx:id="btnModificar" text="Modificar producción"
                                    onAction="#modificarProduccion" maxWidth="Infinity"
                                    styleClass="boton-secundario"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Button fx:id="btnAnular" text="Anular producción"
                                    onAction="#anularProduccion" maxWidth="Infinity"
                                    styleClass="boton-anular"
                                    style="-fx-background-color: #DC3545;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-min-height: 44;
                                           -fx-cursor: hand;"
                                    GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Button fx:id="btnLimpiar" text="Limpiar formulario"
                                    onAction="#limpiarFormulario" maxWidth="Infinity"
                                    styleClass="boton-limpiar"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- TARJETA DE DISPONIBILIDAD -->
                    <VBox spacing="17" prefWidth="295" minWidth="225"
                          styleClass="produccion-panel-datos"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E1E9F3;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(18,49,89,0.08), 12, 0, 0, 3);">

                        <Label text="Disponibilidad del lote"
                               styleClass="seccion-titulo" wrapText="true"/>
                        <Label text="Consulta las truchas disponibles antes de registrar una cosecha."
                               wrapText="true" styleClass="subtitulo"/>
                        <Separator/>

                        <VBox spacing="10" styleClass="produccion-disponibles"
                              style="-fx-background-color: #EAF5FF;
                                     -fx-background-radius: 11;
                                     -fx-padding: 18;">
                            <Label text="TRUCHAS DISPONIBLES"
                                   styleClass="indicador-titulo"/>
                            <Label fx:id="lblTruchasDisponibles"
                                   text="Seleccione un lote" wrapText="true"
                                   styleClass="produccion-disponibles-valor"
                                   style="-fx-text-fill: #087CC1;
                                          -fx-font-size: 21px;
                                          -fx-font-weight: bold;"/>
                            <Label text="Disponibilidad según los registros del sistema"
                                   wrapText="true" styleClass="subtitulo"/>
                        </VBox>

                        <Separator/>
                        <Label text="Recomendaciones de registro"
                               styleClass="seccion-titulo" wrapText="true"/>
                        <Label text="Seleccione el lote del que se realizó la cosecha."
                               wrapText="true" styleClass="produccion-ayuda"/>
                        <Label text="Registre la cantidad de peces cosechados y su peso total."
                               wrapText="true" styleClass="produccion-ayuda"/>
                        <Label text="Revise los datos antes de registrar o modificar una producción."
                               wrapText="true" styleClass="produccion-ayuda"/>
                    </VBox>
                </HBox>

                <!-- HISTORIAL -->
                <VBox spacing="15" styleClass="tarjeta">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="5">
                            <Label text="Historial de producción"
                                   styleClass="seccion-titulo"/>
                            <Label text="Consulta los registros de cosechas almacenados en H2."
                                   styleClass="subtitulo"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="HISTORIAL" styleClass="etiqueta-superior"/>
                    </HBox>

                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por lote, fecha o estado..."
                               styleClass="campo"/>
                    <TableView fx:id="tablaProduccion" prefHeight="350"
                               minHeight="280">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colId" text="ID"
                                         prefWidth="55" minWidth="40"/>
                            <TableColumn fx:id="colLote" text="Lote"
                                         prefWidth="95" minWidth="65"/>
                            <TableColumn fx:id="colFecha" text="Fecha"
                                         prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colCantidad" text="Truchas"
                                         prefWidth="95" minWidth="75"/>
                            <TableColumn fx:id="colPesoTotal" text="Peso total (kg)"
                                         prefWidth="135" minWidth="100"/>
                            <TableColumn fx:id="colEstado" text="Estado"
                                         prefWidth="120" minWidth="85"/>
                            <TableColumn fx:id="colObservaciones" text="Observaciones"
                                         prefWidth="240" minWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="No hay producciones registradas"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
